{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TapkaCraft Launcher",
  "version": "0.1.0",
  "identifier": "cz.tapkacraft.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TapkaCraft Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 650,
        "resizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "TapkaCraft",
    "shortDescription": "TapkaCraft Launcher",
    "longDescription": "TapkaCraft Launcher is an independent Minecraft launcher and is not affiliated with Mojang Studios or Microsoft. Minecraft itself remains the property of its respective owners.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
